{
  "name": "wau-node",
  "version": "0.1.0",
  "license": "AGPL-3.0-only AND MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --minify --outfile dist/wau-node.js",
    "compile": "bun build src/index.ts --compile --minify --outfile dist/wau-node",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "bun scripts/smoke-test.ts",
    "relay-test": "bun scripts/relay-test.ts",
    "discovery-test": "bun scripts/discovery-test.ts"
  },
  "dependencies": {
    "socket.io": "^4.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ws": "^8.5.12",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.6.0"
  }
}
