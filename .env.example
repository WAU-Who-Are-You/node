NODE_PORT=3003
# public https origin of this node (behind your TLS reverse proxy) — required
NODE_PUBLIC_URL=https://node.example.com
NODE_NAME=my-node
NODE_DATA_DIR=./data
# official registry origin — leave empty to run standalone with static peers
NODE_REGISTRY_URL=https://registry.example.com
# optional: peers to keep linked, comma-separated origins
NODE_PEERS=
# registered (default with registry) | open
NODE_PEER_POLICY=registered
NODE_MAX_CLIENTS=5000
NODE_MAX_CLIENTS_PER_IP=20
NODE_MAX_PEERS=256
# read client IPs from X-Forwarded-For: false | loopback (proxy on this host) | true (only if the port is NOT exposed directly)
NODE_TRUST_PROXY=false
# off = standalone relay (no /peer, no registry, no outbound links)
NODE_FEDERATION=on
# dev/LAN only
NODE_ALLOW_INSECURE=false
NODE_DEBUG=false
